<Window x:Class="CityMatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CityMatch"
        mc:Ignorable="d"
        FontFamily="Calibri"
        Title="CityMatch – Horizontia Reisen GmbH" 
        Height="800" 
        Width="1200" 
        WindowStartupLocation="CenterScreen"
        Icon="/Resource/Horizontia.ico">
        
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="1" Margin="10" TextAlignment="Left" FontSize="40" FontWeight="Bold" Text="Suchergebnisse:"/>
        <StackPanel Orientation="Horizontal">
            <Image Margin="-20" Grid.Column="0" Source="/Resource/FirmenLogo_Horizontia_Final.png" VerticalAlignment="Top" Height="100"/>
            
        </StackPanel>
        <StackPanel Grid.Column="0">            
            
            <Border BorderBrush="#CCC" BorderThickness="1" Background="#F5F5F5" CornerRadius="5" Margin="10,75,10,10">
                <ScrollViewer BorderBrush="#CCC" BorderThickness="1" Background="AliceBlue" Height="400" x:Name="ChatScroll" VerticalScrollBarVisibility="Visible">
                    <Grid>
                        <TextBlock x:Name="BegrüßungsText" FontSize="30">
                            Hallo mein Name ist Egon!
                        <LineBreak/>
                         Geben Sie hier die Kundenwünsche ein
                        </TextBlock>
                        <StackPanel x:Name="ChatPanel" Margin="10"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <TextBlock Text="Eingabe:" FontSize="20"/>
            
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="10">
                <TextBox PreviewKeyDown="EingabeBox_KeyDown" AcceptsReturn="True" FontSize="20" x:Name="EingabeBox" Background ="AliceBlue" BorderThickness="0" Width="auto" Height="165" TextWrapping="Wrap"/>
            </Border>
            
            
                
                <Border Width="100" CornerRadius="5" BorderBrush="Gray" BorderThickness="2" Background="DarkBlue" Padding="1">
                    <Button FontSize="18" Click="SuchenButton_Click" x:Name="suchenButton_Click" BorderThickness="0" Width="100" Height="30" Background="darkBlue" Foreground="LightGray">Suchen</Button>
                </Border>
                
            
        </StackPanel>
        

        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="10,75,10,70">
            <StackPanel Background="AliceBlue" Height="640">
               
                <StackPanel Margin="10,0,0,0" x:Name="ErgebnisPanel"/>                
            </StackPanel>
        </Border>


    </Grid>

</Window>



